{
	// F5 runs the working tree in a separate Extension Development Host window,
	// rebuilt on save by the "watch" task. Tests run through `npm test` (vscode-test).
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}"],
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"sourceMaps": true,
			"preLaunchTask": "watch"
		}
	]
}
